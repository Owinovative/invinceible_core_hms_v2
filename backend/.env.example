# Server
PORT=3000
API_DOCS_ENABLED=true
NODE_ENV=development

# Frontend URLs allowed by CORS
FRONTEND_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:3001,http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000

# Database
DATABASE_PROVIDER=mysql
DATABASE_URL=mysql://user:password@localhost:3306/invinceible_core_hms_v2
# Render PostgreSQL example after tested migration:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@host:5432/invinceible_core_hms

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
LAB_SIGNING_KEY=replace-with-a-separate-random-secret-at-least-48-characters
PASSWORD_MIN_LENGTH=12
AUTH_FAILED_LOGIN_DELAY_MAX_MS=2500
AUTH_COOKIE_MAX_AGE_SECONDS=86400
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# Set only when the frontend and backend must share a parent cookie domain.
AUTH_COOKIE_DOMAIN=
STEP_UP_TTL_SECONDS=300
STEP_UP_ENFORCEMENT_ENABLED=false

# Cache, rate limit, and request safety
REDIS_URL=
CACHE_PREFIX=inv_hms
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_DASHBOARD_TTL_SECONDS=30
CACHE_REFERENCE_TTL_SECONDS=300
CACHE_IN_MEMORY_MAX_ITEMS=10000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_MAX=60
DASHBOARD_RATE_LIMIT_MAX=120
PDF_RATE_LIMIT_MAX=20
MPESA_RATE_LIMIT_MAX=5
PUBLIC_VERIFY_RATE_LIMIT_MAX=30
REQUEST_TIMEOUT_MS=30000
BODY_LIMIT=4mb
PDF_IMAGE_MAX_BYTES=512000

# AI assistant
# Keep this only on the backend environment. Never expose it in the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Safaricom Daraja / M-PESA STK Push
# Use sandbox while testing, then production after Safaricom activates your live app.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-backend.example.com/billing/payments/mpesa/callback
# Paybill: CustomerPayBillOnline. Till/Buy Goods: CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PROMPT_LOCK_SECONDS=90
MPESA_MAX_CONCURRENT_PROMPTS=20
MPESA_REQUEST_TIMEOUT_MS=15000
MPESA_STATUS_CACHE_SECONDS=10

# Queue and worker mode
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5
QUEUE_PREFIX=inv_hms
WORKER_MODE=false

# Outbound patient and staff communication. Provider endpoints must accept
# { channel, recipient, senderId, templateKey, variables } as JSON.
SMS_ENABLED=false
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=
NOTIFICATION_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# KRA eTIMS fiscalization
# Disabled by default. Set ETIMS_ENABLED=true and ETIMS_MODE=sandbox or
# production to use the real OSCU API; ETIMS_MODE=mock uses the built-in
# mock adapter (no KRA connectivity required).
# ---------------------------------------------------------------------------
ETIMS_ENABLED=false
ETIMS_MODE=mock
# Required when ETIMS_MODE is sandbox/production:
ETIMS_BASE_URL=
ETIMS_TIN=
ETIMS_BHF_ID=00
# Device credential issued during OSCU device initialization. Secret.
ETIMS_CMC_KEY=
ETIMS_DEVICE_SERIAL=
ETIMS_TIMEOUT_MS=15000
ETIMS_MAX_ATTEMPTS=8
# Default KRA tax type: A = VAT exempt (medical services)
ETIMS_DEFAULT_TAX_CODE=A
ETIMS_VAT_RATE=16
# Override the receipt QR verification URL if KRA changes it:
ETIMS_RECEIPT_VERIFY_URL=

# ---------------------------------------------------------------------------
# DHA (Digital Health Agency) interoperability
# Disabled by default. Keep production mode disabled until DHA certification
# is complete and a certification reference has been issued.
# ---------------------------------------------------------------------------
DHA_ENABLED=false
DHA_MODE=mock
# Required when DHA_MODE is sandbox/production:
DHA_BASE_URL=
# Current DHA OAuth2 client credentials. Store only in a secret manager.
DHA_AUTH_STRATEGY=oauth2
DHA_CLIENT_ID=
DHA_CLIENT_SECRET=
# Transitional UAT only. Production refuses legacy-basic authentication.
DHA_USERNAME=
DHA_PASSWORD=
DHA_CONSUMER_KEY=
DHA_AGENT_ID=
# Separate credentials shared with DHA for POST /integrations/dha/callbacks/claim-status.
DHA_CALLBACK_USERNAME=
DHA_CALLBACK_PASSWORD=
# Optional override. Defaults to DHA_BASE_URL/tenants/token.
DHA_TOKEN_URL=
# Optional base for SHR clinical routes when DHA_BASE_URL ends in /api/v1.
DHA_CLINICAL_BASE_URL=
DHA_API_VERSION=v1
DHA_SPEC_VERSION=
# FHIR profile/coding base used inside SHA bundles. Defaults to the documented
# QA or production Apeiro endpoint according to DHA_MODE.
DHA_FHIR_BASE_URL=
# Optional bootstrap fallback. Live requests use each verified Facility record.
DHA_FACILITY_ID=
DHA_FACILITY_ID_TYPE=fr-code
# A base64-encoded 32-byte key used to encrypt consent credentials at rest.
DATA_ENCRYPTION_KEY=
# Production-only certification gate. Do not enable for development/UAT.
DHA_PRODUCTION_ACTIVATION_APPROVED=false
DHA_CERTIFICATION_REFERENCE=
DHA_TIMEOUT_MS=15000
DHA_MAX_ATTEMPTS=8

# Shared Health Record publication. When enabled, startup fails closed unless
# DHA is enabled and all live-mode registry/specification settings are valid.
SHR_ENABLED=false
SHR_TIMEOUT_MS=30000
SHR_RETRY_LIMIT=5

# ---------------------------------------------------------------------------
# DHA Terminology Service Configuration
# ---------------------------------------------------------------------------
TERMINOLOGY_ENABLED=true
TERMINOLOGY_BASE_URL=
TERMINOLOGY_SYNC_INTERVAL_MS=86400000
TERMINOLOGY_DEFAULT_PAGE_SIZE=25

# Integration outbound queue worker
INTEGRATION_WORKER_ENABLED=true
INTEGRATION_WORKER_POLL_MS=5000
INTEGRATION_QUEUE_BATCH_SIZE=10
INTEGRATION_RETRY_BASE_DELAY_MS=30000
INTEGRATION_RETRY_MAX_DELAY_MS=3600000
INTEGRATION_STUCK_REQUEST_MS=600000

# Development-only password reset helpers
PASSWORD_RESET_BASE_URL=http://localhost:3001/reset-password
RETURN_DEV_RESET_TOKEN=false

# Render production examples:
# FRONTEND_URL=https://your-render-frontend.onrender.com
# FRONTEND_ORIGINS=https://your-render-frontend.onrender.com,https://your-custom-domain.example
# MPESA_CALLBACK_URL=https://your-render-backend.onrender.com/billing/payments/mpesa/callback
# PASSWORD_RESET_BASE_URL=https://your-render-frontend.onrender.com/reset-password
