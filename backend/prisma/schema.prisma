  @@map("legal_documents")
}

model LegalAcceptance {
  id         Int           @id @default(autoincrement())
  userId     Int
  documentId Int
  acceptedAt DateTime      @default(now())
  ipAddress  String?       @db.VarChar(100)
  userAgent  String?       @db.Text
  user       User          @relation(fields: [userId], references: [id])
  document   LegalDocument @relation(fields: [documentId], references: [id])

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
  @@map("legal_acceptances")
}

model ConsentRequest {
  id                  Int      @id @default(autoincrement())
  patientId           Int
  contactId           Int
  interventionCodes   Json // Array of intervention codes
  status              String   @default("PENDING") @db.VarChar(50)
  dhaConsentRequestId String   @db.VarChar(120) // ID from the Send OTP response
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([dhaConsentRequestId])
  @@map("consent_requests")
}

model ConsentAuthorization {
  id             Int       @id @default(autoincrement())
  patientId      Int
  consultationId Int? // Optional initial link, but typically required once visit formally started
  consentToken   String    @db.LongText
  authGuid       String?   @db.VarChar(120) // For biometric
  status         String    @default("AUTHORIZED") @db.VarChar(50)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([patientId])
  @@index([consultationId])
  @@index([status])
  @@map("consent_authorizations")
}

model ConsentAuditLog {
  id            Int      @id @default(autoincrement())
  patientId     Int
  userId        Int?
  facilityId    Int?
  action        String   @db.VarChar(100) // REQUESTED, VERIFIED, FAILED
  outcome       String   @db.VarChar(100)
  ipAddress     String?  @db.VarChar(100)
  correlationId String?  @db.VarChar(120)
  createdAt     DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  facility Facility? @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@index([userId])
  @@index([facilityId])
  @@map("consent_audit_logs")
}

// ---------------------------------------------------------------------------
// Terminology Service Models
// ---------------------------------------------------------------------------

model TerminologySource {
  id          Int      @id @default(autoincrement())
  sourceId    String   @unique @db.VarChar(120) // e.g. ICD-11, LOINC, KEML
  name        String   @db.VarChar(255)
  owner       String   @db.VarChar(120)
  url         String?  @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  concepts    TerminologyConcept[]
  collections TerminologyCollection[]

  @@map("terminology_sources")
}

model TerminologyCollection {
  id           Int      @id @default(autoincrement())
  collectionId String   @unique @db.VarChar(120) // e.g. kenya-patient-identifiers
  name         String   @db.VarChar(255)
  owner        String   @db.VarChar(120)
  url          String?  @db.VarChar(255)
  description  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sourceId Int?
  source   TerminologySource?   @relation(fields: [sourceId], references: [id])
  concepts TerminologyConcept[] @relation("CollectionConcepts")

  @@index([sourceId])
  @@map("terminology_collections")
}

model TerminologyVersion {
  id        Int      @id @default(autoincrement())
  system    String   @db.VarChar(120) // e.g. ICD-11, LOINC
  version   String   @db.VarChar(120) // e.g. 2024-01
  isCurrent Boolean  @default(true)
  syncedAt  DateTime @default(now())

  @@unique([system, version])
  @@index([isCurrent])
  @@map("terminology_versions")
}

model TerminologyConcept {
  id           Int     @id @default(autoincrement())
  uuid         String  @unique @db.VarChar(120)
  system       String  @db.VarChar(255) // FHIR system URL
  code         String  @db.VarChar(120)
  display      String  @db.VarChar(500)
  conceptClass String? @db.VarChar(120) // Diagnosis, Procedure, Drug, Lab
  datatype     String? @db.VarChar(120)
  retired      Boolean @default(false)
  owner        String  @db.VarChar(120)
  version      String? @db.VarChar(120)
  metadata     Json? // Stores synonyms and names array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceId    Int?
  source      TerminologySource?      @relation(fields: [sourceId], references: [id])
  collections TerminologyCollection[] @relation("CollectionConcepts")

  mappingsAsSource TerminologyMapping[] @relation("MappingSource")
  mappingsAsTarget TerminologyMapping[] @relation("MappingTarget")

  // Relationships back to clinical tables
  consultationPrimaryDiagnoses   Consultation[]          @relation("ConsultationPrimaryDiagnosis")
  consultationSecondaryDiagnoses Consultation[]          @relation("ConsultationSecondaryDiagnoses")
  medicines                      Medicine[]              @relation("MedicineTerminology")
  labTestCatalogs                LabTestCatalog[]        @relation("LabTestTerminology")
  shaClaims                      ShaClaim[]              @relation("ShaClaimDiagnosis")
  consultationProcedures         ConsultationProcedure[] @relation("ProcedureTerminology")

  @@unique([system, code, version])
  @@index([code])
  @@index([conceptClass])
  @@index([display])
  @@map("terminology_concepts")
}

model TerminologyMapping {
  id              Int      @id @default(autoincrement())
  sourceConceptId Int
  targetConceptId Int
  mapType         String   @db.VarChar(100) // e.g. equivalent, broader, narrower
  createdAt       DateTime @default(now())

  sourceConcept TerminologyConcept @relation("MappingSource", fields: [sourceConceptId], references: [id])
  targetConcept TerminologyConcept @relation("MappingTarget", fields: [targetConceptId], references: [id])

  @@unique([sourceConceptId, targetConceptId, mapType])
  @@index([sourceConceptId])
  @@index([targetConceptId])
  @@map("terminology_mappings")
}

model TerminologySyncHistory {
  id              Int       @id @default(autoincrement())
  syncMode        String    @db.VarChar(50) // INITIAL, INCREMENTAL, MANUAL
  targetSystem    String?   @db.VarChar(120) // e.g. ICD-11 (null for full sync)
  status          String    @db.VarChar(50) // SUCCESS, FAILED, IN_PROGRESS
  conceptsAdded   Int       @default(0)
  conceptsUpdated Int       @default(0)
  durationMs      Int       @default(0)
  errorMessage    String?   @db.Text
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([status])
  @@index([startedAt])
  @@map("terminology_sync_history")
}

model ShrPublication {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid()) @db.VarChar(36)
  encounterId Int? // Link to Consultation if applicable
  patientId   Int
  policy      String   @db.VarChar(100) // e.g. Encounter Only, Full Record
  state       String   @default("CREATED") @db.VarChar(50) // State Machine status
  priority    Int      @default(0) // Higher number = higher priority
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [encounterId], references: [id])

  snapshots    ShrBundleSnapshot[]
  attempts     ShrPublicationAttempt[]
  dependencies ShrBundleDependency[]

  @@index([patientId])
  @@index([encounterId])
  @@index([state])
  @@map("shr_publications")
}

model ShrBundleSnapshot {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid()) @db.VarChar(36)
  publicationId  Int
  version        Int      @default(1)
  fhirVersion    String   @db.VarChar(20) // e.g. 4.0.1
  profileVersion String?  @db.VarChar(100) // e.g. Kenya_Patient_Profile_v1
  bundleHash     String   @db.VarChar(64) // SHA-256
  payload        Json // The actual FHIR Transaction Bundle
  createdAt      DateTime @default(now())

  publication ShrPublication          @relation(fields: [publicationId], references: [id])
  attempts    ShrPublicationAttempt[]

  @@unique([publicationId, version])
  @@index([bundleHash])
  @@map("shr_bundle_snapshots")
}

model ShrPublicationAttempt {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid()) @db.VarChar(36)
  publicationId Int
  snapshotId    Int
  queueJobId    String?   @db.VarChar(100)
  status        String    @db.VarChar(50) // QUEUED, TRANSMITTING, SUCCESS, FAILED
  correlationId String?   @db.VarChar(100)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  publication ShrPublication    @relation(fields: [publicationId], references: [id])
  snapshot    ShrBundleSnapshot @relation(fields: [snapshotId], references: [id])

  transmissions   ShrTransmissionHistory[]
  errors          ShrPublicationError[]
  acknowledgement ShrAcknowledgement?

  @@index([publicationId])
  @@index([status])
  @@index([correlationId])
  @@map("shr_publication_attempts")
}

model ShrTransmissionHistory {
  id              Int      @id @default(autoincrement())
  attemptId       Int
  endpoint        String   @db.VarChar(255)
  method          String   @db.VarChar(10)
  requestHeaders  Json?
  responseStatus  Int?
  responseHeaders Json?
  responseBody    String?  @db.LongText
  durationMs      Int?
  transmittedAt   DateTime @default(now())

  attempt ShrPublicationAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@map("shr_transmission_history")
}

model ShrAcknowledgement {
  id           Int      @id @default(autoincrement())
  attemptId    Int      @unique
  dhaReceiptId String?  @db.VarChar(100)
  status       String   @db.VarChar(50) // ACCEPTED, REJECTED
  message      String?  @db.Text
  payload      Json?
  receivedAt   DateTime @default(now())

  attempt ShrPublicationAttempt @relation(fields: [attemptId], references: [id])

  @@index([dhaReceiptId])
  @@map("shr_acknowledgements")
}

model ShrPublicationError {
  id        Int      @id @default(autoincrement())
  attemptId Int
  errorType String   @db.VarChar(100) // VALIDATION, NETWORK, COMPLIANCE, DHA_REJECTED
  message   String   @db.Text
  details   Json?
  createdAt DateTime @default(now())

  attempt ShrPublicationAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([errorType])
  @@map("shr_publication_errors")
}

model ShrPublicationMetrics {
  id                  Int      @id @default(autoincrement())
  date                DateTime @db.Date
  totalPublications   Int      @default(0)
  successfulCount     Int      @default(0)
  failedCount         Int      @default(0)
  avgValidationTimeMs Int      @default(0)
  avgPublishTimeMs    Int      @default(0)
  totalRetries        Int      @default(0)

  @@unique([date])
  @@map("shr_publication_metrics")
}

model ShrBundleDependency {
  id            Int    @id @default(autoincrement())
  publicationId Int
  resourceType  String @db.VarChar(50) // e.g. Observation
  resourceId    String @db.VarChar(100) // HMS ID
  fhirReference String @db.VarChar(255) // urn:uuid:xxx

  publication ShrPublication @relation(fields: [publicationId], references: [id])

  @@index([publicationId])
  @@index([resourceType, resourceId])
  @@map("shr_bundle_dependencies")
}

// =============================================================================
// PHASE 4: CLINICAL EVENT PLATFORM — TRANSACTIONAL OUTBOX & EVENT STORE
// =============================================================================

/// Transactional Outbox — events written atomically with business operations.
/// The EventDispatcher (Milestone 2) reads this table and dispatches to subscribers.
model ClinicalEventOutbox {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @db.VarChar(36) // UUIDv4 — globally unique event ID
  correlationId String    @db.VarChar(36) // Links events across one patient journey
  aggregateId   String    @db.VarChar(100) // e.g., "patient_42", "encounter_99"
  aggregateType String    @db.VarChar(50) // e.g., "PATIENT", "ENCOUNTER"
  eventType     String    @db.VarChar(100) // e.g., "VitalsRecorded"
  eventCategory String    @db.VarChar(20) // DOMAIN | INTEGRATION
  eventVersion  Int       @default(1)
  patientId     Int
  encounterId   Int?
  facilityId    Int
  branchId      Int?
  tenantId      Int       @default(1)
  userId        Int?
  sourceModule  String    @db.VarChar(50)
  priority      String    @db.VarChar(20) // CRITICAL | HIGH | MEDIUM | LOW
  priorityOrder Int       @default(2) // Numeric for ORDER BY DESC
  slaSeconds    Int?
  payload       Json
  checksum      String    @db.VarChar(64) // SHA-256 of payload
  signature     String    @db.VarChar(64) // HMAC-SHA256 tamper detection
  metadata      Json?
  occurredAt    DateTime
  status        String    @default("PENDING") @db.VarChar(20) // PENDING | DISPATCHING | DISPATCHED | FAILED
  dispatchedAt  DateTime?
  failureReason String?   @db.Text
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([status, priorityOrder(sort: Desc), occurredAt])
  @@index([aggregateId, status])
  @@index([patientId])
  @@index([facilityId])
  @@index([correlationId])
  @@index([eventType])
  @@map("clinical_event_outbox")
}

/// Immutable event store — every successfully dispatched clinical event.
/// This is the permanent record and forms the basis for replay, timeline, and audit.
model ClinicalEvent {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @db.VarChar(36)
  correlationId  String    @db.VarChar(36)
  aggregateId    String    @db.VarChar(100)
  aggregateType  String    @db.VarChar(50)
  eventType      String    @db.VarChar(100)
  eventCategory  String    @db.VarChar(20)
  eventVersion   Int       @default(1)
  sequenceNumber Int? // Monotonically increasing per aggregate
  patientId      Int
  encounterId    Int?
  facilityId     Int
  branchId       Int?
  tenantId       Int       @default(1)
  userId         Int?
  sourceModule   String    @db.VarChar(50)
  priority       String    @db.VarChar(20)
  slaSeconds     Int?
  payload        Json
  checksum       String    @db.VarChar(64)
  signature      String    @db.VarChar(64)
  metadata       Json?
  occurredAt     DateTime
  processedAt    DateTime?
  status         String    @default("PROCESSED") @db.VarChar(20) // PROCESSED | FAILED | DEAD_LETTER | ARCHIVED
  slaBreached    Boolean   @default(false)
  processingMs   Int? // Actual processing duration in ms
  outboxId       Int? // Link back to originating outbox entry

  @@index([patientId, occurredAt])
  @@index([facilityId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([correlationId])
  @@index([aggregateId])
  @@index([status])
  @@index([tenantId, facilityId, patientId])
  @@map("clinical_events")
}

/// Subscriber processing status — tracks each subscriber's processing of each event.
model EventSubscriberStatus {
  id             Int       @id @default(autoincrement())
  eventId        Int
  subscriberName String    @db.VarChar(100) // e.g., "ShrModule"
  isolationLevel String    @db.VarChar(20) // CRITICAL | NORMAL | OPTIONAL
  status         String    @default("PENDING") @db.VarChar(20) // PENDING | SUCCESS | FAILED | SKIPPED
  startedAt      DateTime?
  completedAt    DateTime?
  processingMs   Int?
  slaBreached    Boolean   @default(false)
  retryCount     Int       @default(0)
  failureReason  String?   @db.Text
  createdAt      DateTime  @default(now())

  @@unique([eventId, subscriberName])
  @@index([eventId])
  @@index([subscriberName, status])
  @@index([status, isolationLevel])
  @@map("event_subscriber_statuses")
}

/// Dead Letter Queue — events that have exhausted retries and require manual intervention.
model DeadLetterEvent {
  id Int @id @default(autoincrement())

  // Original event identity
  originalEventId String @db.VarChar(36) // UUID of the original event
  eventType       String @db.VarChar(100)
  eventCategory   String @db.VarChar(20) // DOMAIN | INTEGRATION
  eventVersion    Int    @default(1)
  correlationId   String @db.VarChar(100)
  aggregateId     String @db.VarChar(100)
  aggregateType   String @db.VarChar(100)

  // Clinical context
  patientId    Int?
  encounterId  Int?
  facilityId   Int?
  tenantId     Int?
  sourceModule String? @db.VarChar(100)

  // Payload (immutable copy from failed event)
  payload    Json
  checksum   String   @db.VarChar(64)
  signature  String   @db.VarChar(128)
  metadata   Json     @default("{}")
  occurredAt DateTime

  // DLQ classification
  failureReason    String    @db.Text
  failureType      String    @db.VarChar(50) // SUBSCRIBER_FAILURE | TAMPER_DETECTED | SCHEMA_VIOLATION | TIMEOUT | UNKNOWN
  failedSubscriber String?   @db.VarChar(150) // Which subscriber failed
  retryCount       Int       @default(0)
  lastRetryAt      DateTime?

  // DLQ lifecycle
  status     String    @default("PENDING") @db.VarChar(30) // PENDING | REPLAYED | ARCHIVED | IGNORED | DELETED
  resolution String?   @db.VarChar(30) // MANUAL | AUTO_RETRY | TIMEOUT
  resolvedAt DateTime?
  resolvedBy String?   @db.VarChar(150) // Admin who resolved it
  notes      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originalEventId])
  @@index([status, createdAt])
  @@index([eventType, status])
  @@index([patientId, status])
  @@index([facilityId, status])
  @@index([failureType])
  @@map("dead_letter_events")
}

/// Event Replay Job — tracks a replay operation from start to finish.
model EventReplayJob {
  id     Int    @id @default(autoincrement())
  jobId  String @unique @db.VarChar(36) // UUID
  mode   String @db.VarChar(20) // FULL | SAFE | SIMULATION
  status String @default("RUNNING") @db.VarChar(20) // RUNNING | COMPLETED | FAILED | CANCELLED

  // Replay filters (serialized)
  filters Json @default("{}") // patientId, aggregateId, correlationId, eventTypes, dateRange

  // Progress tracking
  totalEvents     Int @default(0)
  processedEvents Int @default(0)
  skippedEvents   Int @default(0)
  failedEvents    Int @default(0)

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  // Initiated by
  initiatedBy String? @db.VarChar(150)
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([mode, status])
  @@map("event_replay_jobs")
}

// ==========================================
// PHASE 5: ENTERPRISE WORKFLOW ENGINE
// ==========================================

/// Workflow Definition — The core template metadata.
model WorkflowDefinition {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50) // e.g. "OUTPATIENT_V1"
  name        String   @db.VarChar(100) // e.g. "Standard Outpatient Workflow"
  description String?  @db.Text
  category    String   @db.VarChar(50) // e.g. "CLINICAL", "ADMINISTRATIVE"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions  WorkflowVersion[]
  instances WorkflowInstance[]

  @@map("workflow_definitions")
}

/// Workflow Version — Immutable JSON schema contract.
model WorkflowVersion {
  id                   Int       @id @default(autoincrement())
  workflowDefinitionId Int
  versionNumber        Int
  schema               Json // The proprietary JSON schema (triggers, steps, variables, SLAs)
  isPublished          Boolean   @default(false)
  isDeprecated         Boolean   @default(false)
  publishedAt          DateTime?
  deprecatedAt         DateTime?
  createdBy            String?   @db.VarChar(150)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  instances  WorkflowInstance[]

  @@unique([workflowDefinitionId, versionNumber])
  @@map("workflow_versions")
}

/// Workflow Instance — An active or completed workflow execution.
model WorkflowInstance {
  id                   Int    @id @default(autoincrement())
  instanceId           String @unique @db.VarChar(36) // UUID
  workflowDefinitionId Int
  workflowVersionId    Int

  // Clinical context
  patientId   Int?
  encounterId Int?
  facilityId  Int
  tenantId    Int  @default(1)

  // State Machine
  status        String  @default("CREATED") @db.VarChar(30) // CREATED, READY, IN_PROGRESS, WAITING, BLOCKED, COMPLETED, CANCELLED, FAILED, ESCALATED
  currentStepId String? @db.VarChar(100) // Maps to the step ID in the JSON schema

  // Data
  contextVariables Json @default("{}") // Runtime variables injected/evaluated

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  version    WorkflowVersion    @relation(fields: [workflowVersionId], references: [id])

  steps  WorkflowStep[]
  tasks  WorkflowTask[]
  timers WorkflowTimer[]
  audits WorkflowAudit[]

  @@index([patientId, status])
  @@index([encounterId])
  @@index([facilityId, status])
  @@index([workflowDefinitionId, status])
  @@map("workflow_instances")
}

/// Workflow Step — Individual execution states within an instance.
model WorkflowStep {
  id                 Int    @id @default(autoincrement())
  workflowInstanceId Int
  stepDefinitionId   String @db.VarChar(100) // Maps to the JSON schema step ID

  status      String    @default("PENDING") @db.VarChar(30) // PENDING, ACTIVE, COMPLETED, SKIPPED, FAILED
  startedAt   DateTime?
  completedAt DateTime?

  // Idempotency fingerprint component
  triggerEventId String? @db.VarChar(36)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@unique([workflowInstanceId, stepDefinitionId, triggerEventId])
  @@index([workflowInstanceId, status])
  @@map("workflow_steps")
}

/// Workflow Transition — Represents a state jump.
model WorkflowTransition {
  id                 Int      @id @default(autoincrement())
  workflowInstanceId Int
  fromStepId         String?  @db.VarChar(100)
  toStepId           String   @db.VarChar(100)
  triggerEventId     String?  @db.VarChar(36)
  conditionMet       String?  @db.Text
  transitionedAt     DateTime @default(now())

  @@index([workflowInstanceId])
  @@map("workflow_transitions")
}

/// Workflow Task — Human task management.
model WorkflowTask {
  id                 Int    @id @default(autoincrement())
  taskId             String @unique @db.VarChar(36) // UUID
  workflowInstanceId Int
  stepDefinitionId   String @db.VarChar(100)

  title       String  @db.VarChar(255)
  description String? @db.Text
  priority    String  @default("NORMAL") @db.VarChar(20) // LOW, NORMAL, HIGH, URGENT

  status String @default("UNASSIGNED") @db.VarChar(30) // UNASSIGNED, ASSIGNED, CLAIMED, IN_PROGRESS, COMPLETED, CANCELLED, EXPIRED

  // Assignment criteria
  targetRole       String? @db.VarChar(100)
  targetDepartment String? @db.VarChar(100)
  targetSkill      String? @db.VarChar(100)

  // SLA
  dueDate   DateTime?
  isOverdue Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance    WorkflowInstance     @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  assignments WorkflowAssignment[]
  escalations WorkflowEscalation[]

  @@index([workflowInstanceId, status])
  @@index([targetRole, status])
  @@index([targetDepartment, status])
  @@map("workflow_tasks")
}

/// Workflow Assignment — Allocation of a task to a user.
model WorkflowAssignment {
  id             Int      @id @default(autoincrement())
  workflowTaskId Int
  userId         Int
  assignedAt     DateTime @default(now())
  status         String   @default("ACTIVE") @db.VarChar(30) // ACTIVE, REASSIGNED, COMPLETED

  task WorkflowTask @relation(fields: [workflowTaskId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([workflowTaskId])
  @@map("workflow_assignments")
}

/// Workflow Timer — Scheduled hooks for Reminders, Deadlines, Escalations.
model WorkflowTimer {
  id                 Int      @id @default(autoincrement())
  workflowInstanceId Int
  timerType          String   @db.VarChar(50) // DEADLINE, REMINDER, ESCALATION, AUTO_TRANSITION
  executeAt          DateTime
  status             String   @default("PENDING") @db.VarChar(30) // PENDING, EXECUTED, CANCELLED
  payload            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@index([status, executeAt])
  @@index([workflowInstanceId])
  @@map("workflow_timers")
}

/// Workflow Escalation — SLA/Timer breach resolution.
model WorkflowEscalation {
  id                Int       @id @default(autoincrement())
  workflowTaskId    Int
  reason            String    @db.Text
  escalatedToRole   String?   @db.VarChar(100)
  escalatedToUserId Int?
  status            String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, RESOLVED
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  task WorkflowTask @relation(fields: [workflowTaskId], references: [id], onDelete: Cascade)

  @@index([workflowTaskId])
  @@index([status])
  @@map("workflow_escalations")
}

/// Workflow Audit — Immutable log of all transitions.
model WorkflowAudit {
  id                 Int      @id @default(autoincrement())
  workflowInstanceId Int
  oldState           String?  @db.VarChar(100)
  newState           String   @db.VarChar(100)
  triggerEvent       String?  @db.VarChar(100)
  actor              String?  @db.VarChar(150)
  reason             String?  @db.Text
  correlationId      String?  @db.VarChar(100)
  durationMs         Int?
  metadata           Json?
  timestamp          DateTime @default(now())

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceId, timestamp])
  @@index([correlationId])
  @@map("workflow_audits")
}

/// Workflow Metric
model WorkflowMetric {
  id         Int      @id @default(autoincrement())
  metricName String   @db.VarChar(100)
  value      Float  // non-monetary metric, kept as Float
  tags       Json?
  timestamp  DateTime @default(now())

  @@index([metricName, timestamp])
  @@map("workflow_metrics")
}

/// Workflow Snapshot
model WorkflowSnapshot {
  id                 Int      @id @default(autoincrement())
  timestamp          DateTime @default(now())
  activeInstances    Int
  completedInstances Int
  failedInstances    Int
  overdueTasks       Int
  data               Json

  @@index([timestamp])
  @@map("workflow_snapshots")
}
