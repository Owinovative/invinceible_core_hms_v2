// ---------------------------------------------------------------------------
// Government integration layer (KRA eTIMS + DHA)
// facilityId/branchId are intentionally scalar (no FK) on queue/log tables so
// integration bookkeeping never blocks core-entity maintenance.
// ---------------------------------------------------------------------------

// Fiscal document mirror of an HMS invoice as registered (or pending) with
// KRA eTIMS. An invoice has at most one active SALE document plus any number
// of CREDIT_NOTE / DEBIT_NOTE amendments referencing it.
model EtimsInvoice {
  id                  Int            @id @default(autoincrement())
  documentType        String         @default("SALE") @db.VarChar(30)
  traderInvoiceNumber String         @unique @db.VarChar(100)
  statusCode          String         @default("PENDING") @db.VarChar(40)
  receiptTypeCode     String         @default("S") @db.VarChar(5)
  paymentTypeCode     String?        @db.VarChar(5)
  cuInvoiceNumber     String?        @db.VarChar(120)
  cuReceiptNumber     String?        @db.VarChar(120)
  internalData        String?        @db.VarChar(255)
  receiptSignature    String?        @db.VarChar(255)
  sdcId               String?        @db.VarChar(120)
  mrcNumber           String?        @db.VarChar(120)
  sdcDateTime         DateTime?
  qrCodeUrl           String?        @db.Text
  qrCodeData          String?        @db.LongText
  totalTaxableAmount  Decimal        @default(0) @db.Decimal(18, 2)
  totalTaxAmount      Decimal        @default(0) @db.Decimal(18, 2)
  totalAmount         Decimal        @default(0) @db.Decimal(18, 2)
  currency            String         @default("KES") @db.VarChar(10)
  taxBreakdown        Json?
  requestPayload      Json?
  responsePayload     Json?
  errorMessage        String?        @db.Text
  cancelReason        String?        @db.Text
  attemptCount        Int            @default(0)
  correlationId       String?        @db.VarChar(120)
  lastAttemptAt       DateTime?
  submittedAt         DateTime?
  acceptedAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  invoiceId           Int
  originalId          Int?
  facilityId          Int
  branchId            Int?
  invoice             Invoice        @relation(fields: [invoiceId], references: [id])
  original            EtimsInvoice?  @relation("EtimsInvoiceAmendments", fields: [originalId], references: [id])
  amendments          EtimsInvoice[] @relation("EtimsInvoiceAmendments")

  @@index([invoiceId])
  @@index([originalId])
  @@index([statusCode])
  @@index([documentType, statusCode])
  @@index([facilityId, branchId, statusCode])
  @@index([cuInvoiceNumber])
  @@index([createdAt])
  @@map("etims_invoices")
}

// Durable outbound queue for all government integrations. Rows survive
// restarts, drive exponential-backoff retries, and end in DEAD_LETTER when
// the retry budget is exhausted (recoverable via requeue).
model IntegrationOutboundRequest {
  id             Int       @id @default(autoincrement())
  integration    String    @db.VarChar(30)
  operation      String    @db.VarChar(80)
  entityType     String    @db.VarChar(80)
  entityId       String    @db.VarChar(120)
  payload        Json?
  status         String    @default("PENDING") @db.VarChar(30)
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(8)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?   @db.Text
  lastHttpStatus Int?
  correlationId  String?   @db.VarChar(120)
  idempotencyKey String    @unique @db.VarChar(191)
  facilityId     Int?
  branchId       Int?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([integration, status])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("integration_outbound_requests")
}

// Structured audit record for every external API interaction (one row per
// HTTP attempt): endpoint, latency, retry count, correlation id, outcome.
// Request/response bodies are never stored here; secrets are never logged.
model IntegrationApiLog {
  id            Int      @id @default(autoincrement())
  integration   String   @db.VarChar(30)
  endpoint      String   @db.VarChar(255)
  method        String   @db.VarChar(10)
  requestId     String   @db.VarChar(120)
  correlationId String?  @db.VarChar(120)
  httpStatus    Int?
  outcome       String   @db.VarChar(30)
  latencyMs     Int      @default(0)
  retryCount    Int      @default(0)
  errorMessage  String?  @db.Text
  facilityId    Int?
  createdAt     DateTime @default(now())

  @@index([integration, createdAt])
  @@index([correlationId])
  @@index([requestId])
  @@index([outcome, createdAt])
  @@map("integration_api_logs")
}

// One row per DHA interaction (verification, encounter, referral,
// eligibility, consent, record exchange, claim) with the FHIR payloads
