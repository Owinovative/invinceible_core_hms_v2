  shaClaimId       Int?
  consultationId   Int?
  facilityId       Int
  branchId         Int?
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([transactionType, statusCode])
