# Dependencies and package-manager caches
**/node_modules/
**/.pnp/
**/.pnp.*
**/.yarn/cache/
**/.yarn/install-state.gz
**/.npm/
**/.pnpm-store/
**/.bun/

# Environment files and local secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/.envrc
**/.direnv/
**/*credentials*.json
**/*credentials*.yml
**/*credentials*.yaml
**/*secret*.json
**/*secret*.yml
**/*secret*.yaml
**/service-account*.json
**/secrets/
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*

# Compiled and framework-generated output
**/dist/
**/build/
**/.next/
**/out/
**/.nuxt/
**/.turbo/
**/.cache/
**/.parcel-cache/
**/.vite/
**/.swc/
**/generated/prisma/
**/next-env.d.ts
**/*.tsbuildinfo
**/.eslintcache
**/.stylelintcache

# Test and coverage output
**/coverage/
**/coverage-integration/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/blob-report/
**/.vitest/
**/.jest-cache/
**/junit.xml
**/.artifacts/

# Logs, process files, and diagnostic reports
**/logs/
**/*.log
**/npm-debug.log*
**/pnpm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/lerna-debug.log*
**/*.pid
**/*.pid.lock
**/report.*.json
**/next-panic-*.log
/core
/**/core.[0-9]*
/**/*.core
/**/*.core.dump
**/*.stackdump

# Local runtime data and database backups
**/uploads/
**/backups/
**/storage/private/
**/storage/uploads/
**/storage/exports/
**/.pglite/
**/pgdata/
**/*.sqlite
**/*.sqlite3
**/*.sqlite-shm
**/*.sqlite-wal
**/*.db-journal
**/*.db
**/*.dump
**/*.sql.gz
**/*.backup
**/*.bak

# Temporary files
**/.temp/
**/.tmp/
**/tmp/
**/.history/
**/.attachments/
**/*.swp
**/*.swo
**/*~

# IDE, editor, and local agent configuration
.vscode/
.idea/
.agents/
.codex/
**/.project
**/.classpath
**/.settings/
**/*.sublime-workspace

# Operating-system metadata
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
